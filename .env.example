# YouTube MCP Server - Variaveis de ambiente
# Copie este arquivo para .env e preencha os valores

# Chave da YouTube Data API v3 (OBRIGATORIA)
# Obtenha em: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Transporte do servidor: "streamable-http" (servico remoto) ou "stdio" (local)
MCP_TRANSPORT=streamable-http

# Host/porta usados no modo streamable-http
HOST=0.0.0.0
PORT=8000
